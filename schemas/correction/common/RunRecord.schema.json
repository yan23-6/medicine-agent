{
  "$defs": {
    "GenerationMethod": {
      "enum": [
        "rule",
        "model",
        "human",
        "imported"
      ],
      "title": "GenerationMethod",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "warning",
        "error"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "confirmed",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SkillIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "SkillIssue",
      "type": "object"
    },
    "SkillStatus": {
      "enum": [
        "success",
        "partial_success",
        "failure",
        "needs_review"
      ],
      "title": "SkillStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "caller": {
      "title": "Caller",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "generation_method": {
      "$ref": "#/$defs/GenerationMethod"
    },
    "input_id": {
      "title": "Input Id",
      "type": "string"
    },
    "input_schema_id": {
      "title": "Input Schema Id",
      "type": "string"
    },
    "invocation_id": {
      "title": "Invocation Id",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/SkillIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "output_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Id"
    },
    "output_schema_id": {
      "title": "Output Schema Id",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "runtime": {
      "additionalProperties": true,
      "title": "Runtime",
      "type": "object"
    },
    "skill_id": {
      "title": "Skill Id",
      "type": "string"
    },
    "skill_version": {
      "title": "Skill Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SkillStatus"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "invocation_id",
    "task_id",
    "caller",
    "skill_id",
    "skill_version",
    "input_id",
    "input_schema_id",
    "output_schema_id",
    "status",
    "generation_method",
    "review_status",
    "started_at",
    "completed_at",
    "duration_ms"
  ],
  "title": "RunRecord",
  "type": "object"
}
