{
  "additionalProperties": false,
  "properties": {
    "reference": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reference",
      "type": "string"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "stage": {
      "enum": [
        "extraction",
        "semantic_candidate"
      ],
      "title": "Stage",
      "type": "string"
    },
    "unit_kind": {
      "default": "unknown",
      "enum": [
        "physical_page",
        "text_line",
        "structured_unit",
        "image",
        "unknown"
      ],
      "title": "Unit Kind",
      "type": "string"
    },
    "units": {
      "items": {
        "type": "integer"
      },
      "maxItems": 100000,
      "title": "Units",
      "type": "array"
    }
  },
  "required": [
    "stage",
    "reference"
  ],
  "title": "CoverageHistory",
  "type": "object"
}
