{
  "$defs": {
    "CorrectionStatus": {
      "enum": [
        "none",
        "proposed",
        "confirmed",
        "rejected"
      ],
      "title": "CorrectionStatus",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "corrected_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Text"
        },
        "correction_status": {
          "$ref": "#/$defs/CorrectionStatus",
          "default": "none"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "fragment_id": {
          "title": "Fragment Id",
          "type": "string"
        },
        "location": {
          "additionalProperties": true,
          "title": "Location",
          "type": "object"
        },
        "raw_text": {
          "title": "Raw Text",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "fragment_id",
        "raw_text",
        "location"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "combine_evidence": {
      "default": false,
      "title": "Combine Evidence",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "use_model": {
      "default": false,
      "title": "Use Model",
      "type": "boolean"
    }
  },
  "required": [
    "evidence"
  ],
  "title": "KnowledgeDistillationInput",
  "type": "object"
}
