    },
    "uncertainty_id": {
      "title": "Uncertainty Id",
      "type": "string"
    },
    "uncertainty_type": {
      "default": "transcription_or_mapping",
      "title": "Uncertainty Type",
      "type": "string"
    }
  },
  "required": [
    "uncertainty_id",
    "raw_key",
    "raw_text",
    "raw_value",
    "correction_candidates",
    "evidence_refs"
  ],
  "title": "CaseUncertainty",
  "type": "object"
