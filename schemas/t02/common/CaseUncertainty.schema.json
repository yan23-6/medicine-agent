      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applies_to_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applies To Ref"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "correction_candidates": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Correction Candidates",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "raw_key": {
      "title": "Raw Key",
      "type": "string"
    },
    "raw_text": {
      "title": "Raw Text",
      "type": "string"
    },
    "raw_value": {
