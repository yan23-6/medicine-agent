{
  "$defs": {
    "AssertionStatus": {
      "enum": [
        "source_explicit",
        "rule_inferred",
        "model_candidate",
        "human_confirmed",
        "human_rejected"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "CodeableConcept": {
      "additionalProperties": false,
      "properties": {
        "codings": {
          "items": {
            "$ref": "#/$defs/Coding"
          },
          "title": "Codings",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "CodeableConcept",
      "type": "object"
    },
    "Coding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "user_selected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Selected"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "system",
        "code"
      ],
      "title": "Coding",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "applies_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "evidence_ref": {
          "title": "Evidence Ref",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "strength": {
          "$ref": "#/$defs/ConfidenceLevel",
          "default": "unknown"
        }
      },
      "required": [
        "evidence_ref",
        "role"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "EvidenceRole": {
      "enum": [
        "supporting",
        "weak_supporting",
        "counterevidence",
        "ambiguous",
        "context"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "GenerationMethod": {
      "enum": [
        "rule",
        "model",
        "human",
        "imported"
      ],
      "title": "GenerationMethod",
      "type": "string"
    },
    "MedicalSystem": {
      "enum": [
        "general",
        "tcm",
        "western",
        "safety",
        "integrative",
        "research",
        "unknown"
      ],
      "title": "MedicalSystem",
      "type": "string"
    },
    "ReasoningNodeType": {
      "enum": [
        "observation",
        "feature",
        "etiology",
        "anatomical_location",
        "nature",
        "hypothesis",
        "pathomechanism",
        "syndrome",
        "diagnosis",
        "differential",
        "risk",
        "contradiction",
        "state",
        "goal",
        "operator",
        "action",
        "outcome",
        "other"
      ],
      "title": "ReasoningNodeType",
      "type": "string"
    },
    "ReasoningRole": {
      "enum": [
        "primary",
        "secondary",
        "concomitant",
        "candidate",
        "differential",
        "excluded",
        "context"
      ],
      "title": "ReasoningRole",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "confirmed",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "TemporalCertainty": {
      "enum": [
        "exact",
        "approximate",
        "uncertain",
        "unknown"
      ],
      "title": "TemporalCertainty",
      "type": "string"
    },
    "TemporalExtent": {
      "additionalProperties": false,
      "properties": {
        "certainty": {
          "$ref": "#/$defs/TemporalCertainty",
          "default": "unknown"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "title": "TemporalExtent",
      "type": "object"
    },
    "TemporalPrecision": {
      "enum": [
        "year",
        "month",
        "day",
        "minute",
        "second",
        "range",
        "relative",
        "unknown"
      ],
      "title": "TemporalPrecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "items": {
        "type": "string"
      },
      "title": "Applicability",
      "type": "array"
    },
    "assertion_status": {
      "$ref": "#/$defs/AssertionStatus"
    },
    "concept": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeableConcept"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceLevel",
      "default": "unknown"
    },
    "counterevidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Counterevidence Refs",
      "type": "array"
    },
    "encounter_refs": {
      "items": {
        "type": "string"
      },
      "title": "Encounter Refs",
      "type": "array"
    },
    "evidence_links": {
      "items": {
        "$ref": "#/$defs/EvidenceLink"
      },
      "title": "Evidence Links",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "generation_method": {
      "$ref": "#/$defs/GenerationMethod"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "medical_system": {
      "$ref": "#/$defs/MedicalSystem"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Missing Evidence",
      "type": "array"
    },
    "narrative": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narrative"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "node_type": {
      "$ref": "#/$defs/ReasoningNodeType"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "unreviewed"
    },
    "role": {
      "$ref": "#/$defs/ReasoningRole"
    },
    "valid_time": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalExtent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "node_id",
    "node_type",
    "medical_system",
    "label",
    "role",
    "assertion_status",
    "generation_method"
  ],
  "title": "ReasoningNode",
  "type": "object"
}
